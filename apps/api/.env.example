# Buildline API configuration (copy to .env or export in your environment)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres@localhost:5432/buildline
API_URL=http://localhost:4000
APP_URL=http://localhost:5173
# Required in production: a long random string used to sign file URLs and tokens
APP_SECRET=dev-secret-change-me-please-0000
SESSION_TTL_DAYS=30
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# console | smtp | memory
EMAIL_DRIVER=console
# SMTP_URL=smtps://user:pass@smtp.example.com:465
EMAIL_FROM="Buildline <no-reply@buildline.local>"
RATE_LIMIT_MAX=300
MAX_UPLOAD_MB=200
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,ionic://localhost,http://localhost
